{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Artifact",
      "NotebookEdit",
      "Agent"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm)",
      "Bash(rm:*)"
    ]
  }
}
