{
  "name": "converters",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "content-pipeline"
  ],
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.js",
    "dev": "vite",
