{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verdict.schema.json",
  "title": "Gate verdict",
  "description": "The uniform envelope EVERY gate emits - deterministic or LLM-backed. This uniformity is what lets a future Reviser consume findings from any gate without special-casing it, and lets new gates be added without touching the pipeline.",
  "type": "object",
  "required": ["gate", "verdict", "findings"],
  "additionalProperties": false,
  "properties": {
    "gate": {
      "type": "string",
      "description": "Gate id, e.g. \"frontmatter\", \"links\", \"seo\"."
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "revise", "reject"],
      "description": "pass = proceed. revise = fixable, send to the Reviser with these findings. reject = not worth iterating on (duplicate, off-topic, wrong premise) - quarantine directly."
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "threshold": { "type": "number", "minimum": 0, "maximum": 100 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "message"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable dotted id, e.g. \"links.tool.unknown\". Stable so failures can be counted over time and individually suppressed."
          },
          "severity": { "type": "string", "enum": ["error", "warn", "info"] },
          "message": { "type": "string", "minLength": 1 },
          "location": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "field": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "heading": { "type": "string" },
              "excerpt": { "type": "string" }
            }
          },
          "fixHint": {
            "type": "string",
            "description": "Actionable instruction. Fed to the Reviser verbatim in later phases, so it must say what to DO, not just what is wrong."
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "durationMs": { "type": "number" },
        "model": { "type": "string" },
        "promptVersion": { "type": "string" },
        "costUsd": { "type": "number" }
      }
    }
  }
}
