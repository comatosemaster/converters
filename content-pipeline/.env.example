# Copy to .env at the REPO ROOT (one level up), then fill in.
# .env is gitignored. Never commit a real key.

# Required for any step that calls a model (outline, draft, revise).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Set to 1 to run every model call against the built-in mock provider:
# no network, no cost, schema-shaped output. Useful for exercising the
# pipeline in CI or while working on a non-AI step.
# The --mock CLI flag sets this for a single run.
# PIPELINE_MOCK_LLM=1

# Set to any value for full error details instead of a one-line message.
# DEBUG=1
