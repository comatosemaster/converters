# Copy to .env at the REPO ROOT (one level up), then fill in.
# .env is gitignored. Never commit a real key.

# --- Required ---------------------------------------------------------------
# All three model tiers default to OpenAI (see content-pipeline/config/models.js),
# so this is the only key you need.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Optional ---------------------------------------------------------------
# Only needed if you point a tier at Anthropic in config/models.js.
# The provider is per-tier, so you can mix (e.g. drafting on one, cheap
# structural calls on the other).
# ANTHROPIC_API_KEY=sk-ant-...

# Set to 1 to run every model call against the built-in mock provider:
# no network, no cost, schema-shaped output. Useful for exercising the
# pipeline in CI or while working on a non-AI step.
# The --mock CLI flag sets this for a single run.
# PIPELINE_MOCK_LLM=1

# Set to any value for full error details instead of a one-line message.
# DEBUG=1
